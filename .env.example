# Hermes Chat Server Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Server Configuration
# =============================================================================

# Host to bind the server to (default: localhost)
SERVER_HOST=localhost

# Port to listen on (default: 8080)
SERVER_PORT=8080

# =============================================================================
# AWS Cognito Configuration
# =============================================================================

# AWS region where your Cognito user pool is located (default: us-east-1)
COGNITO_REGION=us-east-1

# Your Cognito User Pool ID (required)
# Find this in AWS Console > Cognito > User Pools > [Your Pool] > General settings
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Log format: json, text (default: text)
LOG_FORMAT=text
